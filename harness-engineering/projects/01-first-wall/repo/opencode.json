{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git diff*": "allow",
      "git status*": "allow",
      "git push --force*": "deny",
      "rm -rf*": "deny",
      "cat .env*": "deny",
      "cat secrets*": "deny"
    }
  }
}
