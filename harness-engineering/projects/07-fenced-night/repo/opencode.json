{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "secrets/**": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "ask",
      "npm test*": "allow",
      "npm run lint*": "allow",
      "git diff*": "allow",
      "git push origin claude/*": "allow",
      "git push --force*": "deny",
      "rm -rf*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "Invoke-WebRequest*": "deny",
      "iwr*": "deny"
    }
  }
}
